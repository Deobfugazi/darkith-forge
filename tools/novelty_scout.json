{
  "_doc": "novelty_scout config. Edit freely; `python3 tools/novelty_scout.py sources` lists what it will ask. Queries are SMART: a fracture phrase combined with a field term, not a single naive keyword. `fracture_markers`/`omega_fit` score each result; `negative_terms` penalise noise; `require_any` keeps only items touching the omega field. min_write = refuse to overwrite a good findings file with fewer than this many results (network-blip guard).",
  "queries": {
    "arxiv": [
      "cat:cs.LG AND abs:\"open problem\"",
      "abs:\"remains an open challenge\" AND abs:\"resource-constrained\"",
      "abs:\"no known\" AND abs:\"efficient\" AND cat:cs.DC",
      "abs:\"on-device\" AND abs:\"energy\" AND abs:\"constraint\"",
      "abs:\"deterministic build\" OR abs:\"reproducible build\"",
      "abs:\"static analysis\" AND abs:\"false positive\" AND abs:\"unsolved\"",
      "abs:\"out of memory\" AND abs:\"mobile\" AND abs:\"bottleneck\"",
      "abs:\"self-healing\" AND abs:\"system\" AND abs:\"open\""
    ],
    "crossref": [
      "unresolved bottleneck edge computing",
      "open problem reproducible builds software supply chain",
      "on-device machine learning memory constraint",
      "no known method resource constrained device",
      "static analysis false negatives open challenge"
    ],
    "github_issues": [
      "label:\"help wanted\" \"no known fix\" memory",
      "label:\"bug\" \"out of memory\" is:issue",
      "\"open problem\" reproducible build is:issue",
      "label:\"performance\" bottleneck embedded is:issue"
    ],
