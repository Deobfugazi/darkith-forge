# ---- build / test noise -------------------------------------------------
__pycache__/
*.pyc
# Runtime evidence, not source. The receipt ledger is append-only and hash-chained, so it
# accumulates one entry per gate per run; committing it would make every CI run produce a
# diff, and the drift gate would then fail forever on its own audit trail. The chain is
# verified locally (tools/ci_receipts.py --verify) and regenerates from a fresh run.
proof/ci_receipts.db
.forge_work/
.tools/
*.log
# Sealed cycle evidence is the exception: the seal cites these logs and I8 checks that
# each citation resolves. A cited .log that git drops turns a sealed cycle into one
# that cannot be verified from a fresh clone.
!proof/revitalization/*/S*.log

# ---- scratch harnesses (regenerable) ------------------------------------
.shell-harness/

# ---- generated webapp output (rebuild with build/build-forge.py) --------
# The canonical shell is `darkith home forge.html`; this fused artifact is regenerated
# from it. Tracking both is two live copies of one file (NEVER #11).
darkith forge.html

# ---- regenerated delivery output (rebuild with build/*.py) --------------
delivery/
dl/
dist/
darkith-forge-bundle.zip
darkith_source_fixed.zip
darkith_source_*.zip
darkith_omega_source.zip
savf1-bundle.zip
darkith-inscriber.zip

# ---- screenshots (regenerable by build/omega/ui-test.py) ----------------
build/omega/*.png

# ---- SECRETS: never commit signing key material -------------------------
# The APK signing identity lives ONLY in the built APK's assets/engine/ and
# in your offline backup. It must never be a plain file in git.
**/release_key
**/release_cert
*.keystore
*.p8
*.pem

# ---- agent session memory (ephemeral, never tracked) ----
.openhands/memory/

# ---- savf runtime state (lock + manifest live in the CWD) ----
.savf/

# ---- agent scratch + built APKs + regenerable trees (never track) --------
.agent_tmp/
app-signed.apk
app-signed.apk.idsig
build/termkit_omega/
app/libs/
dist/
tree_omega/
darkith_omega_source.zip
*.idsig

# node deps (local test harness only)
node_modules/
package-lock.json
prerun-out/
