# ---- build / test noise -------------------------------------------------
__pycache__/
*.pyc
.forge_work/
.tools/
*.log

# ---- scratch harnesses (regenerable) ------------------------------------
.shell-harness/

# ---- generated webapp output (rebuild with build/build-forge.py) --------
# The canonical shell is `darkith home forge.html`; this fused artifact is regenerated
# from it. Tracking both is two live copies of one file (NEVER #11).
darkith forge.html

# ---- regenerated delivery output (rebuild with build/*.py) --------------
delivery/
dl/
dist/
darkith-forge-bundle.zip
darkith_source_fixed.zip
darkith_source_*.zip
darkith_omega_source.zip
savf1-bundle.zip
darkith-inscriber.zip

# ---- screenshots (regenerable by build/omega/ui-test.py) ----------------
build/omega/*.png

# ---- SECRETS: never commit signing key material -------------------------
# The APK signing identity lives ONLY in the built APK's assets/engine/ and
# in your offline backup. It must never be a plain file in git.
**/release_key
**/release_cert
*.keystore
*.p8
*.pem

# ---- agent session memory (ephemeral, never tracked) ----
.openhands/memory/
