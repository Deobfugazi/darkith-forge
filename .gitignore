# ---- build / test noise -------------------------------------------------
__pycache__/
*.pyc
.forge_work/
.tools/
*.log

# ---- scratch harnesses (regenerable) ------------------------------------
.shell-harness/

# ---- regenerated delivery output (rebuild with build/*.py) --------------
delivery/
dl/
darkith-forge-bundle.zip
darkith_source_fixed.zip
darkith_source_*.zip
savf1-bundle.zip
darkith-inscriber.zip

# ---- screenshots (regenerable by build/omega/ui-test.py) ----------------
build/omega/*.png

# ---- SECRETS: never commit signing key material -------------------------
# The APK signing identity lives ONLY in the built APK's assets/engine/ and
# in your offline backup. It must never be a plain file in git.
**/release_key
**/release_cert
*.keystore
*.p8
*.pem

# ---- runtime gate screenshot (regenerable) -----------------------------
build/runtime-*.png

# ---- build inputs fetched by build&install.sh + build output -----------
# apksig is fetched into app/libs/ (the canonical copy is the tracked libs/apksig.jar);
# app-signed.apk is the build output, regenerated by build.sh.
app/libs/
app-signed.apk
